                                        <MenuItem.Icon><TextBlock Text="⬆" Foreground="#008844" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Đưa xuống cuối" Click="MenuMoveSelectedToBottom_Click">
                                        <MenuItem.Icon><TextBlock Text="⬇" Foreground="#008844" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Mở link trong trình duyệt" Click="MenuOpenInBrowser_Click">
                                        <MenuItem.Icon><TextBlock Text="🌐" Foreground="#0066CC" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Copy link các dòng đang chọn (Copy Selected Links)" Click="MenuCopySelectedLinks_Click">
