                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="AllowDrop" Value="True"/>
                                <Setter Property="Focusable" Value="True"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ResultsThumbnailItem_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="PreviewMouseMove" Handler="ResultsThumbnailItem_PreviewMouseMove"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ResultsThumbnailItem_PreviewMouseRightButtonDown"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3A3200"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4"
                                        Background="#111827"
                                        BorderBrush="{StaticResource CyberpunkCyanBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MouseEnter="GalleryResultPreviewHost_MouseEnter"
                                        MouseMove="GalleryResultPreviewHost_MouseMove"
                                        MouseLeave="GalleryResultPreviewHost_MouseLeave"
                                        SnapsToDevicePixels="True">
                                    <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#111827"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsPortraitMode}" Value="True"/>
                                                            <Condition Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True"/>
                                                            <Condition Binding="{Binding IsChecked, ElementName=chkHideSettings}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#3A3200"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocusWithin}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Margin="0,0,0,6"
                                                Background="#0A1321"
                                                BorderBrush="{StaticResource CyberpunkCyanBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Height" Value="104"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsPortraitMode}" Value="True"/>
                                                                    <Condition Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True"/>
                                                                    <Condition Binding="{Binding IsChecked, ElementName=chkHideSettings}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                <Setter Property="Height" Value="56"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocusWithin}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasHoverPreviewThumbnailFile}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image Stretch="Uniform"
                                                       Margin="2"
                                                       Source="{Binding HoverPreviewThumbnailImageSource}"/>
                                                <CheckBox IsChecked="{Binding GroupIsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                          Width="18"
                                                          Height="18"
                                                          Margin="4"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Top"/>
                                                
                                                <!-- Thumbnail Drag Handle -->
                                                <Border Background="#CC09101C"
                                                        CornerRadius="3"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="4"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Cursor="SizeAll"
                                                        ToolTip="Kéo thả để sắp xếp">
                                                    <TextBlock Text="☰"
                                                               Foreground="#00F0FF"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Tag="drag_handle"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1">
                                             <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="Auto"/>
                                                     <ColumnDefinition Width="*"/>
                                                 </Grid.ColumnDefinitions>
                                                 <CheckBox Grid.Column="0"
                                                           IsChecked="{Binding GroupIsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                           Width="16"
                                                           Height="16"
                                                           Margin="0,0,4,0"
                                                           VerticalAlignment="Center">
                                                     <CheckBox.Style>
                                                         <Style TargetType="CheckBox">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                             <Style.Triggers>
                                                                 <MultiDataTrigger>
                                                                     <MultiDataTrigger.Conditions>
                                                                         <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsPortraitMode}" Value="True"/>
                                                                         <Condition Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True"/>
                                                                         <Condition Binding="{Binding IsChecked, ElementName=chkHideSettings}" Value="False"/>
                                                                     </MultiDataTrigger.Conditions>
                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                 </MultiDataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </CheckBox.Style>
                                                 </CheckBox>
                                                 <TextBlock Grid.Column="1"
                                                            local:TextBlockLanguageColorizer.HighlightedText="{Binding DisplayName}"
                                                            FontWeight="Bold"
                                                            FontSize="9">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Height" Value="32"/>
                                                             <Setter Property="Margin" Value="0,0,0,4"/>
                                                             <Setter Property="TextWrapping" Value="Wrap"/>
                                                             <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                             <Setter Property="Foreground" Value="{StaticResource CyberpunkTextBrush}"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsParallelSplitParent}" Value="True">
                                                                     <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                 </DataTrigger>
                                                                 <MultiDataTrigger>
                                                                     <MultiDataTrigger.Conditions>
                                                                         <Condition Binding="{Binding IsParallelSplitTask}" Value="True"/>
                                                                         <Condition Binding="{Binding IsParallelSplitParent}" Value="False"/>
                                                                     </MultiDataTrigger.Conditions>
                                                                     <Setter Property="Foreground" Value="#C77DFF"/>
                                                                     <Setter Property="Margin" Value="12,0,0,4"/>
                                                                 </MultiDataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                             </Grid>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True"/>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsPortraitMode}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                            <TextBlock Text="{Binding MissingChapterStatusText, StringFormat=Missing chapter: {0}}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource CyberpunkMutedTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMissingChapterIssue}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MissingChapterStatusText}" Value="complete">
                                                                <Setter Property="Foreground" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DisplayStatusText, StringFormat=Status: {0}}" ToolTip="{Binding DetailedErrorToolTip}"
                                                       Foreground="{StaticResource CyberpunkCyanBrush}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding CurrentProcess, StringFormat=Process: {0}}"
                                                       Foreground="{StaticResource CyberpunkTextBrush}"
                                                       FontSize="9"
                                                       TextWrapping="Wrap"
                                                       Height="24"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Height" Value="15"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                            <Setter Property="Height" Value="20"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" VerticalAlignment="Center">
                                                 <ProgressBar.Style>
                                                     <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressBarSuccess}">
                                                         <Setter Property="Value" Value="{Binding DownloadProgressPercent}"/>
                                                         <Setter Property="Height" Value="13"/>
                                                         <Setter Property="Foreground" Value="#888888"/>
                                                         <Setter Property="BorderThickness" Value="1"/>
                                                         <Setter Property="BorderBrush" Value="#888888"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                 <Setter Property="Height" Value="18"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                 <Setter Property="Foreground" Value="#B19FFB"/><Setter Property="BorderBrush" Value="#B19FFB"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                 <Setter Property="Foreground" Value="{StaticResource CyberpunkCyanBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                             </DataTrigger>
                                                             <MultiDataTrigger>
                                                                  <MultiDataTrigger.Conditions>
                                                                      <Condition Binding="{Binding Status}" Value="Completed"/>
                                                                      <Condition Binding="{Binding DownloadingPageProgress}" Value=""/>
                                                                  </MultiDataTrigger.Conditions>
                                                                  <Setter Property="Foreground" Value="#888888"/><Setter Property="BorderBrush" Value="#888888"/>
                                                                  <Setter Property="Value" Value="100"/>
                                                              </MultiDataTrigger>
                                                              <MultiDataTrigger>
                                                                  <MultiDataTrigger.Conditions>
                                                                      <Condition Binding="{Binding Status}" Value="Completed"/>
                                                                      <Condition Binding="{Binding DownloadingPageProgress}" Value="Done"/>
                                                                  </MultiDataTrigger.Conditions>
                                                                  <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                  <Setter Property="Value" Value="100"/>
                                                              </MultiDataTrigger>
                                                              <MultiDataTrigger>
                                                                  <MultiDataTrigger.Conditions>
                                                                      <Condition Binding="{Binding Status}" Value="Completed"/>
                                                                      <Condition Binding="{Binding DownloadingPageProgress}" Value="Complete"/>
                                                                  </MultiDataTrigger.Conditions>
                                                                  <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                  <Setter Property="Value" Value="100"/>
                                                              </MultiDataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                 <Setter Property="Foreground" Value="#FF8C00"/><Setter Property="BorderBrush" Value="#FF8C00"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                 <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                 <Setter Property="Value" Value="100"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding DownloadingPageProgress}" Value="Done">
                                                                 <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                 <Setter Property="Value" Value="100"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                 <Setter Property="Foreground" Value="#FF0055"/><Setter Property="BorderBrush" Value="#FF0055"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                 <Setter Property="Foreground" Value="#FF0055"/><Setter Property="BorderBrush" Value="#FF0055"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </ProgressBar.Style>
                                             </ProgressBar>
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadProgressText}"
                                                       
                                                       FontWeight="Bold"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="9"/>
                                                         <Setter Property="Foreground" Value="#888888"/>
                                                        <Style.Triggers>
                                                             <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                 <Setter Property="Foreground" Value="#B19FFB"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                 <Setter Property="Foreground" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                 <Setter Property="Foreground" Value="#FF8C00"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                 <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding DownloadingPageProgress}" Value="Done">
                                                                 <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                 <Setter Property="Foreground" Value="#FF0055"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                 <Setter Property="Foreground" Value="#FF0055"/>
                                                             </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                <Setter Property="FontSize" Value="11"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State Grid -->
                    <Grid Grid.Row="3" Name="grdEmptyState" Background="#0A101D" Panel.ZIndex="10" Visibility="Visible">
                        <Border BorderBrush="{StaticResource CyberpunkBorderBrush}" BorderThickness="1" CornerRadius="12" Background="#0A101D">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📂" FontSize="56" HorizontalAlignment="Center" Foreground="{StaticResource CyberpunkMutedTextBrush}" Margin="0,0,0,16"/>
                                <TextBlock Name="txtEmptyStateTitle" Text="DANH SÁCH CHỜ TẢI ĐANG TRỐNG" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource CyberpunkCyanBrush}" Margin="0,0,0,8"/>
                                <TextBlock Name="txtEmptyStateDesc" Text="Dán link truyện hoặc kéo thả file/thư mục vào đây để bắt đầu" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource CyberpunkMutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Download Section -->
                    <Border Grid.Row="4" Name="borderDownloadSection" Style="{StaticResource WorkspaceSectionCard}" Padding="16" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Quick actions -->
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/> <!-- Section title -->
                                    <RowDefinition Height="Auto"/> <!-- Path and Search -->
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="Auto"/> <!-- Folder Actions and Chapter Selection -->
                                    <RowDefinition Height="Auto"/> <!-- Archive Progress -->
                                    <RowDefinition Height="Auto"/> <!-- Connections and Start Download -->
                                </Grid.RowDefinitions>

                            <!-- Hidden Panel containing legacy buttons to maintain C# code-behind compatibility -->
                            <Grid Visibility="Collapsed">
                                <Button Name="btnCopyLinksOnly" Click="BtnCopyLinksOnly_Click"/>
                                <Button Name="btnCopyNamesAndLinks" Click="BtnCopyNamesAndLinks_Click"/>
                                <Button Name="btnCopyChaptersLink" Click="BtnCopyChaptersLink_Click"/>
                                <Button Name="btnMergeLightNovelBookMarkdown" Click="BtnMergeLightNovelBookMarkdown_Click"/>
                                <Button Name="btnMergeParallelSplitChapters" Click="BtnMergeParallelSplitChapters_Click"/>
                                <Button Name="btnRescanMissingChapter" Click="BtnRescanMissingChapter_Click"/>
                                <Button Name="btnPauseMissingChapterScan" Click="BtnPauseResumeDownloadMissingChapters_Click"/>
                                <Button Name="btnOpenMissingChapterCache" Click="BtnOpenDownloadMissingChapterCache_Click"/>
                                <Button Name="btnClearMissingChapterCache" Click="BtnClearDownloadMissingChapterCache_Click"/>
                            </Grid>

                            <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Button Name="btnCopyGroup" Content="SAO CHÉP..." Click="BtnContextMenuOpen_Click" Style="{StaticResource CompactCyanButton}" MinWidth="120" FontWeight="Bold">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy link các dòng đang chọn (Copy Selected Links)" Click="MenuCopySelectedLinks_Click"/>
                                            <MenuItem Header="Copy link các truyện đã tích (Copy Book Links)" Click="BtnCopyLinksOnly_Click"/>
                                            <MenuItem Header="Copy tên + link truyện (Copy Name + Link)" Click="BtnCopyNamesAndLinks_Click"/>
                                            <MenuItem Header="Copy chapters link" Click="BtnCopyChaptersLink_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Name="btnMergeGroup" Content="GỘP TRUYỆN..." Click="BtnContextMenuOpen_Click" Style="{StaticResource CompactPinkButton}" MinWidth="120" FontWeight="Bold" Margin="6,0,0,0">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Gộp Light Novel (Merge Novel Book)" Click="BtnMergeLightNovelBookMarkdown_Click"/>
                                            <MenuItem Header="Gộp chương Split (Auto Merge Split Chapters)" Click="BtnMergeParallelSplitChapters_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Name="btnScanGroup" Content="QUÉT CHƯƠNG THIẾU..." Click="BtnContextMenuOpen_Click" Style="{StaticResource CompactCyanButton}" MinWidth="160" FontWeight="Bold" Margin="6,0,0,0">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Quét lại chương thiếu (Rescan Missing Chapter)" Click="BtnRescanMissingChapter_Click"/>
                                            <MenuItem Header="Tạm dừng quét chương thiếu (Pause Scan)" Click="BtnPauseResumeDownloadMissingChapters_Click"/>
                                            <MenuItem Header="Mở cache JSON (Open Cache JSON)" Click="BtnOpenDownloadMissingChapterCache_Click"/>
                                            <MenuItem Header="Xóa cache JSON (Clear Cache JSON)" Click="BtnClearDownloadMissingChapterCache_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Name="btnRefreshStatus" Content="LÀM MỚI TRẠNG THÁI" Click="BtnRefreshStatus_Click" Style="{StaticResource CompactCyanButton}" MinWidth="140" FontWeight="Bold" Margin="6,0,0,0" Visibility="Collapsed"/>
                                <Button Name="btnClearResults" Content="XÓA HÀNG ĐỢI" Click="BtnClear_Click" Style="{StaticResource CompactPinkButton}" MinWidth="100" FontWeight="Bold" Margin="6,0,0,0"/>
                            </WrapPanel>

                            <TextBlock Grid.Row="2"
                                       Text="DOWNLOAD SETTINGS"
                                       Style="{StaticResource PanelSectionTitle}"
                                       Margin="0,0,0,12"/>

                            <!-- Row 0: Path and Search -->
                            <WrapPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DOWNLOAD PATH" Style="{StaticResource InputLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Name="txtDownloadPath" Style="{StaticResource SurfaceTextBox}" IsReadOnly="True" Width="300" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button Name="btnBrowseFolder" Content="BROWSE" Click="BtnBrowseFolder_Click" Style="{StaticResource CompactCyanButton}" Width="72" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Button Name="btnOpenFolder" Content="&#x1F4C2;" Click="BtnOpenFolder_Click" Style="{StaticResource CompactCyanButton}" Width="92" Margin="0,0,16,0" FontFamily="Segoe UI Emoji" FontSize="12" ToolTip="OPEN FOLDER" VerticalAlignment="Center"/>
                            </WrapPanel>

                            <!-- Row 2: Folder Actions -->
                            <WrapPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Name="txtFolderActionsLabel" Text="FOLDER ACTIONS" Style="{StaticResource InputLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Name="btnCompressBooks" Content="COMPRESS" Click="BtnCompressBooks_Click" Style="{StaticResource CompactCyanButton}" Width="94" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Button Name="btnExtractBooks" Content="EXTRACT" Click="BtnExtractBooks_Click" Style="{StaticResource CompactPinkButton}" Width="86" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DOWNLOAD FOLDER TYPE" Style="{StaticResource InputLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Name="cmbDownloadFolderType" Style="{StaticResource CyberpunkComboBox}" Height="26" Width="120" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" SelectedIndex="0" SelectionChanged="CmbDownloadFolderType_SelectionChanged" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Background="#121622"/>
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource CyberpunkComboBoxItemStyle}"/>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBoxItem Content="Single comic"/>
                                    <ComboBoxItem Content="Multi-comic"/>
                                </ComboBox>
                                <TextBlock Name="lblAutoSplitChapters" Text="AUTO SPLIT CHAPTER" Style="{StaticResource InputLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Name="cmbAutoSplitChapters" Style="{StaticResource CyberpunkComboBox}" Height="26" Width="120" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" SelectedIndex="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Background="#121622"/>
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource CyberpunkComboBoxItemStyle}"/>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBoxItem Content="OFF"/>
                                    <ComboBoxItem Content="50"/>
                                    <ComboBoxItem Content="100"/>
                                    <ComboBoxItem Content="200"/>
                                    <ComboBoxItem Content="300"/>
                                    <ComboBoxItem Content="400"/>
                                </ComboBox>
                                <Button Name="btnApplyAutoSplitChapters" Content="APPLY" Click="BtnApplyAutoSplitChapters_Click" Style="{StaticResource CompactCyanButton}" Width="65" Margin="0" VerticalAlignment="Center"/>
                            </WrapPanel>

                            <Grid Grid.Row="6" Name="archiveProgressPanel" Margin="0,8,0,6" Visibility="Collapsed">
