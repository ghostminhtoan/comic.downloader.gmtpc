                                        <MenuItem.Icon><TextBlock Text="📝" Foreground="#D97700" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Copy chapters link" Click="BtnCopyChaptersLink_Click">
                                        <MenuItem.Icon><TextBlock Text="🔗" Foreground="#D97700" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Merge novel book (Gộp MD)" Click="BtnMergeLightNovelBookMarkdown_Click">
                                        <MenuItem.Icon><TextBlock Text="📄" Foreground="#800080" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Gộp truyện split (Merge Split Chapters)" Click="BtnMergeParallelSplitChapters_Click">
                                        <MenuItem.Icon><TextBlock Text="🧩" Foreground="#800080" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Quét lại chap thiếu (Rescan Missing Chapter)" Click="BtnRescanMissingChapter_Click">
                                        <MenuItem.Icon><TextBlock Text="🔍" Foreground="#D97700" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Pause chap số nguyên thiếu (Pause Missing Chapter Scan)" Click="BtnPauseResumeDownloadMissingChapters_Click">
                                        <MenuItem.Icon><TextBlock Text="⏸" Foreground="#D97700" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Mở cache JSON (Open Cache JSON)" Click="BtnOpenDownloadMissingChapterCache_Click">
                                        <MenuItem.Icon><TextBlock Text="📂" Foreground="#D97700" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Xóa cache JSON (Clear Cache JSON)" Click="BtnClearDownloadMissingChapterCache_Click">
                                        <MenuItem.Icon><TextBlock Text="🗑" Foreground="#CC0033" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Xóa các dòng đang bôi đen (Delete Selected)" Click="MenuDeleteSelected_Click">
                                        <MenuItem.Icon><TextBlock Text="✖" Foreground="#CC0033" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Xóa các dòng đã tích (Delete Checked)" Click="MenuDeleteChecked_Click">
                                        <MenuItem.Icon><TextBlock Text="❌" Foreground="#CC0033" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                     <MenuItem Header="Tải lại các dòng lỗi (Retry error lines)" Click="MenuRetryErrors_Click">
                                         <MenuItem.Icon><TextBlock Text="🔄" Foreground="#CC0033" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Mở thư mục lưu truyện (Open Download Folder)" Click="MenuOpenDownloadFolderInRow_Click">
                                         <MenuItem.Icon><TextBlock Text="📂" Foreground="#00F0FF" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Xuất danh sách truyện lỗi (.txt)" Click="MenuExportErrors_Click">
                                         <MenuItem.Icon><TextBlock Text="📝" Foreground="#FFD78BFF" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                     </MenuItem>
                                     <Separator/>
                                    <MenuItem Header="Tìm trên các web khác (Search with other websites)" Click="MenuSearchWithOtherWebsites_Click">
