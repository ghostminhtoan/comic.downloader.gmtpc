                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=chkWordWrap}" Value="True">
                                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsParallelSplitTask}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C77DFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Chapter Count -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LatestChapterDisplay}" 
                                                           Foreground="{StaticResource CyberpunkMutedTextBrush}" 
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="colMissingChapter" Width="0.9*" SortMemberPath="MissingChapterSortText">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="MISSING CHAPTER" Foreground="{StaticResource CyberpunkPinkBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MissingChapterStatusText}"
                                                   Margin="3,1"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   PreviewMouseLeftButtonDown="MissingChapterStatus_PreviewMouseLeftButtonDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource CyberpunkMutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissingChapterIssue}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MissingChapterStatusText}" Value="complete">
                                                            <Setter Property="Foreground" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                             <!-- Status Column -->
                             <DataGridTemplateColumn x:Name="colStatus" Width="1.15*" SortMemberPath="StatusSortOrder">
                                 <DataGridTemplateColumn.Header>
                                     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                         <TextBlock Text="STATUS" Foreground="{StaticResource CyberpunkPinkBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                         <Button Name="btnSortByStatus" Content="⇅" Click="BtnSortByStatus_Click" Width="22" Height="18" Padding="0" FontSize="10" ToolTip="SORT BY STATUS">
                                             <Button.Style>
                                                 <Style TargetType="Button" BasedOn="{StaticResource CyberpunkButtonCyan}">
                                                     <Setter Property="Margin" Value="0"/>
                                                     <Setter Property="MinWidth" Value="0"/>
                                                 </Style>
                                             </Button.Style>
                                         </Button>
                                     </StackPanel>
                                 </DataGridTemplateColumn.Header>
                                 <DataGridTemplateColumn.CellTemplate>
                                     <DataTemplate>
                                         <Grid Margin="3,1">
                                             <Grid.Style>
                                                 <Style TargetType="Grid">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding ShouldShowStatus}" Value="False">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Grid.Style>
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto"/>
                                                 <RowDefinition Height="Auto"/>
                                             </Grid.RowDefinitions>

                                             <!-- Row 0: Status Text, Action Buttons and Error Button -->
                                             <Grid Grid.Row="0" Margin="0,0,0,1">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                 </Grid.ColumnDefinitions>

                                                 <!-- Status Display -->
                                                 <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                                     <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyberpunkCyanBrush}" Text="{Binding DisplayStatusText}" ToolTip="{Binding DetailedErrorToolTip}">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                         <Setter Property="Foreground" Value="Red"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                         <Setter Property="Foreground" Value="Red"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                 </StackPanel>

                                                 <!-- Row Buttons -->
                                               <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                                   <Button Content="&#x23F9;" Click="BtnRowStop_Click" Width="22" Height="18" Margin="1,0" Padding="0" FontSize="8" ToolTip="Stop download">
                                                       <Button.Style>
                                                           <Style TargetType="Button" BasedOn="{StaticResource CyberpunkButtonPink}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Error Button -->
                                                 <Button Grid.Column="2" Content="{Binding ErrorCount, StringFormat=Err: {0}}" 
                                                         Click="BtnShowErrors_Click"
                                                         VerticalAlignment="Center"
                                                         Margin="4,0,0,0" Height="18" Padding="3,0" FontSize="9">
                                                     <Button.Style>
                                                         <Style TargetType="Button" BasedOn="{StaticResource CyberpunkButtonCyan}">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                             <Setter Property="Background" Value="#ff2222"/>
                                                             <Setter Property="BorderBrush" Value="#ff4444"/>
                                                             <Setter Property="Foreground" Value="White"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </Button.Style>
                                                 </Button>
                                             </Grid>

                                             <!-- Row 1: Progress Bar with Text Overlay -->
                                                 <Grid Grid.Row="1" Margin="0">
                                                 <Grid.Style>
                                                     <Style TargetType="Grid">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Setter Property="Visibility" Value="Visible"/>
                                                         <Setter Property="Height" Value="10"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                 <Setter Property="Height" Value="5"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Grid.Style>

                                                 <ProgressBar Minimum="0" Maximum="100" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" VerticalAlignment="Center">
                                                      <ProgressBar.Style>
                                                          <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressBarSuccess}">
                                                              <Setter Property="Value" Value="{Binding DownloadProgressPercent}"/>
                                                              <Setter Property="Foreground" Value="#888888"/>
                                                              <Setter Property="BorderThickness" Value="1"/>
                                                              <Setter Property="BorderBrush" Value="#888888"/>
                                                              <Style.Triggers>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                      <Setter Property="Foreground" Value="#B19FFB"/><Setter Property="BorderBrush" Value="#B19FFB"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                      <Setter Property="Foreground" Value="{StaticResource CyberpunkCyanBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                                  </DataTrigger>
                                                                   <MultiDataTrigger>
                                                                       <MultiDataTrigger.Conditions>
                                                                           <Condition Binding="{Binding Status}" Value="Completed"/>
                                                                           <Condition Binding="{Binding DownloadingPageProgress}" Value=""/>
                                                                       </MultiDataTrigger.Conditions>
                                                                       <Setter Property="Foreground" Value="#888888"/><Setter Property="BorderBrush" Value="#888888"/>
                                                                       <Setter Property="Value" Value="100"/>
                                                                   </MultiDataTrigger>
                                                                   <MultiDataTrigger>
                                                                       <MultiDataTrigger.Conditions>
                                                                           <Condition Binding="{Binding Status}" Value="Completed"/>
                                                                           <Condition Binding="{Binding DownloadingPageProgress}" Value="Done"/>
                                                                       </MultiDataTrigger.Conditions>
                                                                       <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                       <Setter Property="Value" Value="100"/>
                                                                   </MultiDataTrigger>
                                                                   <MultiDataTrigger>
                                                                       <MultiDataTrigger.Conditions>
                                                                           <Condition Binding="{Binding Status}" Value="Completed"/>
                                                                           <Condition Binding="{Binding DownloadingPageProgress}" Value="Complete"/>
                                                                       </MultiDataTrigger.Conditions>
                                                                       <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                       <Setter Property="Value" Value="100"/>
                                                                   </MultiDataTrigger>
                                                                   <DataTrigger Binding="{Binding DownloadingPageProgress}" Value="Done">
                                                                       <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                       <Setter Property="Value" Value="100"/>
                                                                   </DataTrigger>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                      <Setter Property="Foreground" Value="#FF8C00"/><Setter Property="BorderBrush" Value="#FF8C00"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                      <Setter Property="Foreground" Value="#FF0055"/><Setter Property="BorderBrush" Value="#FF0055"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                      <Setter Property="Foreground" Value="#FF0055"/><Setter Property="BorderBrush" Value="#FF0055"/>
                                                                  </DataTrigger>
                                                              </Style.Triggers>
                                                          </Style>
                                                      </ProgressBar.Style>
                                                  </ProgressBar>
                                                 
                                                  <TextBlock Text="{Binding DownloadProgressText}" 
                                                             
                                                            FontSize="8" 
                                                            FontWeight="Bold"
                                                            HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                              <Setter Property="Foreground" Value="#888888"/>
                                                             <Style.Triggers>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                      <Setter Property="Foreground" Value="#B19FFB"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                      <Setter Property="Foreground" Value="{StaticResource CyberpunkCyanBrush}"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                      <Setter Property="Foreground" Value="#FF8C00"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                      <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding DownloadingPageProgress}" Value="Done">
                                                                      <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                      <Setter Property="Foreground" Value="#FF0055"/>
                                                                  </DataTrigger>
                                                                  <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                      <Setter Property="Foreground" Value="#FF0055"/>
                                                                  </DataTrigger>

                                                                 <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                  </TextBlock>
                                             </Grid>
                                         </Grid>
                                     </DataTemplate>
                                 </DataGridTemplateColumn.CellTemplate>
                             </DataGridTemplateColumn>

                             <!-- Process Column -->
                             <DataGridTemplateColumn x:Name="colProcess" Width="0.8*" SortMemberPath="ProcessSortText">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="PROCESS" Foreground="{StaticResource CyberpunkPinkBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Name="btnSortByProcess" Content="⇅" Click="BtnSortByProcess_Click" Width="22" Height="18" Padding="0" FontSize="10" ToolTip="SORT BY PROCESS">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CyberpunkButtonCyan}">
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="MinWidth" Value="0"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                  <DataGridTemplateColumn.CellTemplate>
                                      <DataTemplate>
                                          <StackPanel Margin="2,0" Orientation="Vertical" Background="Transparent">
                                             <StackPanel.Style>
                                                 <Style TargetType="StackPanel">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding ShouldShowProcess}" Value="False">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </StackPanel.Style>

                                             <!-- Row 1: Downloading Chapter -->
                                             <TextBlock Text="{Binding DisplayDownloadingChapter}" 
                                                        Foreground="{StaticResource CyberpunkYellowBrush}" 
                                                        FontSize="10" 
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"/>

                                             <!-- Row 2: Page Progress -->
                                             <TextBlock Text="{Binding DisplayDownloadingPageProgress}" 
                                                        Foreground="{StaticResource CyberpunkTextBrush}" 
                                                        FontSize="9" 
                                                        Margin="0,0,0,0">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="Visibility" Value="Visible"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                         </StackPanel>
                                     </DataTemplate>
                                 </DataGridTemplateColumn.CellTemplate>
                             </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="colSpeed" Width="0.75*" SortMemberPath="DownloadSpeedSortValue">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtSpeedHeader" Text="SPEED" Foreground="{StaticResource CyberpunkPinkBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Name="btnSortBySpeed" Content="&#x21C5;" Click="BtnSortBySpeed_Click" Width="22" Height="18" Padding="0" FontSize="10" ToolTip="SORT BY SPEED">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CyberpunkButtonCyan}">
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="MinWidth" Value="0"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DownloadSpeedText}"
                                                   Foreground="{StaticResource CyberpunkYellowBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="2,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Action Buttons Column -->
                            <DataGridTemplateColumn x:Name="colChapter" Header="CHAPTER" Width="0.72*" SortMemberPath="ChapterSelectionText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ChapterSelectionText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2,1"
                                                 Height="22"
                                                 Padding="4,1"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Style="{StaticResource SurfaceTextBox}" 
                                                 ToolTip="Row chapter filter. Blank = use global chapter selection."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ListBox Grid.Row="3"
                             Name="lbResultsThumbnail"
