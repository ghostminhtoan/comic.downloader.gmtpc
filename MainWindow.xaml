                                    </MenuItem>
                                    <MenuItem Header="Tải các dòng đã tích (Download selected lines)" Click="MenuDownloadChecked_Click">
                                        <MenuItem.Icon><TextBlock Text="⬇" Foreground="#008844" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <!-- Checkbox Column -->
                            <DataGridTemplateColumn Width="38" SortMemberPath="IsChecked">
                                <DataGridTemplateColumn.Header>
                                    <Grid HorizontalAlignment="Center">
                                        <CheckBox Name="chkSelectAll" Click="ChkSelectAll_Click"/>
                                    </Grid>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding GroupIsChecked, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Drag Handle Column -->
                            <DataGridTemplateColumn Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="☰" 
                                                   Foreground="#00F0FF" 
                                                   FontSize="16" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   Cursor="SizeAll" 
                                                   Background="Transparent"
                                                   Tag="drag_handle"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Gallery Details Column (Vertical stack of Name and Link) -->
                            <DataGridTemplateColumn x:Name="colGalleryDetails" Width="3.1*" SortMemberPath="Name">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="COMIC BOOKS" Foreground="{StaticResource CyberpunkPinkBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Name="btnSortByName" Content="⇅" Click="BtnSortByName_Click" Width="22" Height="18" Padding="0" FontSize="10" ToolTip="SORT BY NAME">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CyberpunkButtonCyan}">
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="MinWidth" Value="0"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,0"
                                                    Orientation="Vertical"
                                                    MouseEnter="GalleryResultPreviewHost_MouseEnter"
                                                    MouseMove="GalleryResultPreviewHost_MouseMove"
                                                    MouseLeave="GalleryResultPreviewHost_MouseLeave">
                                            <!-- Title -->
                                             <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="Auto"/>
                                                     <ColumnDefinition Width="*"/>
                                                 </Grid.ColumnDefinitions>
                                                 <CheckBox Grid.Column="0"
                                                           IsChecked="{Binding GroupIsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                           Width="16"
                                                           Height="16"
                                                           Margin="0,0,4,0"
                                                           VerticalAlignment="Center">
                                                     <CheckBox.Style>
                                                         <Style TargetType="CheckBox">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                             <Style.Triggers>
                                                                 <MultiDataTrigger>
                                                                     <MultiDataTrigger.Conditions>
                                                                         <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsPortraitMode}" Value="True"/>
                                                                         <Condition Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True"/>
                                                                         <Condition Binding="{Binding IsChecked, ElementName=chkHideSettings}" Value="False"/>
                                                                     </MultiDataTrigger.Conditions>
                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                 </MultiDataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </CheckBox.Style>
                                                 </CheckBox>
                                                 <TextBlock Grid.Column="1"
                                                            local:TextBlockLanguageColorizer.HighlightedText="{Binding DisplayName}"
                                                            FontWeight="Bold"
                                                            FontSize="12">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Height" Value="32"/>
                                                             <Setter Property="Margin" Value="0,0,0,4"/>
                                                             <Setter Property="TextWrapping" Value="Wrap"/>
                                                             <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                             <Setter Property="Foreground" Value="{StaticResource CyberpunkTextBrush}"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsParallelSplitParent}" Value="True">
                                                                     <Setter Property="Foreground" Value="{StaticResource CyberpunkYellowBrush}"/>
                                                                 </DataTrigger>
                                                                 <MultiDataTrigger>
                                                                     <MultiDataTrigger.Conditions>
                                                                         <Condition Binding="{Binding IsParallelSplitTask}" Value="True"/>
                                                                         <Condition Binding="{Binding IsParallelSplitParent}" Value="False"/>
                                                                     </MultiDataTrigger.Conditions>
                                                                     <Setter Property="Foreground" Value="#C77DFF"/>
                                                                     <Setter Property="Margin" Value="18,0,0,4"/>
                                                                 </MultiDataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                             </Grid>
                                            <Button Content="{Binding ParallelSplitToggleText}"
                                                    Click="BtnToggleParallelSplit_Click"
                                                    Foreground="#C77DFF"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,0,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    FontWeight="Bold">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasParallelSplitChildren}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="{Binding HoverPreviewIndicatorText}"
                                                       Foreground="White"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Grid ToolTip="{Binding DisplayLink}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=chkCompactRows}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Link -->
