<Window x:Class="get_link_manga.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:get_link_manga"
        mc:Ignorable="d"
        Title="Comic-GMTPC v1.0" Height="900" Width="800" MinWidth="550" MinHeight="560"
        Background="{StaticResource CyberpunkDarkBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SizeChanged="Window_SizeChanged"
        StateChanged="MainWindow_StateChanged"
        AllowDrop="True"
        PreviewDragOver="MainWindow_PreviewDragOver"
        Drop="MainWindow_Drop"
        PreviewKeyDown="MainWindow_PreviewPanelHotkeys"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    
    <Grid Name="rootLayout" Margin="18" PreviewMouseLeftButtonDown="RootLayout_PreviewMouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Name="windowControlsHost" HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Panel.ZIndex="500"
                Background="#E0090D16"
                CornerRadius="12"
                BorderBrush="{StaticResource CyberpunkBorderBrush}"
                BorderThickness="1"
                Padding="5"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource MetricCard}" Padding="8,0" Height="26" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="txtTotalBooksLabel" Text="Total Books: " Margin="0,0,5,0" Foreground="{StaticResource CyberpunkTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Name="lblLinkCount" Text="0" Foreground="{StaticResource CyberpunkYellowBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <TextBlock Name="txtBooksCompleteLabel" Text="Books Complete: " Margin="0,0,5,0" Foreground="{StaticResource CyberpunkTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Name="lblBooksCompleteCount" Text="0" Foreground="{StaticResource CyberpunkCyanBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <TextBlock Name="txtErrorBooksLabel" Text="Error Books: " Margin="0,0,5,0" Foreground="{StaticResource CyberpunkTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Name="lblErrorBooksCount" Text="0" Foreground="{StaticResource CyberpunkPinkBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                    </StackPanel.LayoutTransform>
                    <TextBlock Name="lblSidebar" Text="SIDEBAR" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ToggleButton Name="btnToggleSidebar" Click="BtnToggleSidebar_Click" Style="{StaticResource FloatSwitchToggle}" IsChecked="True" ToolTip="Show/Hide Sidebar"/>
                </StackPanel>
                <Button Name="btnMainMove"
                        Content="MOVE"
                        PreviewMouseLeftButtonDown="BtnMainMove_PreviewMouseLeftButtonDown"
                        Style="{StaticResource CyberpunkButtonCyan}"
                        Width="66"
                        Height="26"
                        Margin="0,0,6,0"
                        Padding="0"
                        FontSize="11"
                        FontWeight="Bold"
                        Cursor="SizeAll"
                        ToolTip="Move window"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                    </StackPanel.LayoutTransform>
                    <TextBlock Name="lblPinWindow" Text="PIN" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ToggleButton Name="btnPinWindow" Click="BtnMainTheme_Click" Style="{StaticResource FloatSwitchToggle}" IsChecked="False" ToolTip="Pin window"/>
                </StackPanel>
                <Button Name="btnDownloadWarp"
                        Click="BtnDownloadWarp_Click"
                        Style="{StaticResource CyberpunkButtonCyan}"
                        Width="26"
                        Height="26"
                        Margin="0,0,6,0"
                        Padding="2"
                        ToolTip="Download Cloudflare Warp 1.1.1.1">
                    <Image Source="Resources/1111.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <Button Name="btnMainMinimize"
                        Content="-"
                        Click="BtnMainMinimize_Click"
                        Style="{StaticResource CyberpunkButtonCyan}"
                        Width="24"
                        Height="26"
                        Margin="0,0,6,0"
                        Padding="0"
                        FontSize="14"
                        FontWeight="Bold"
                        ToolTip="Minimize"/>
                <Button Name="btnMainMaximize"
                        Content="&#xE922;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="BtnMainMaximize_Click"
                        Style="{StaticResource CyberpunkButtonCyan}"
                        Width="24"
                        Height="26"
                        Margin="0,0,6,0"
                        Padding="0"
                        FontSize="10"
                        FontWeight="Bold"
                        ToolTip="Maximize"/>
                <Button Name="btnMainClose"
                        Content="X"
                        Click="BtnMainClose_Click"
                        Style="{StaticResource CyberpunkButtonPink}"
                        Width="32"
                        Height="26"
                        Padding="0"
                        FontSize="12"
                        FontWeight="Bold"
                        ToolTip="Close"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Name="gridMainContent" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Name="headerPanel" Grid.Column="0" Grid.Row="0" Padding="16" Margin="0,0,0,0" Style="{StaticResource CyberpunkCard}" Background="{StaticResource CyberpunkHeroBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Name="txtHeaderTitle"
                                       Text="Comic GMTPC"
                                       Style="{StaticResource HeroTitleText}"
                                       Margin="0,2,0,0"/>
                            <TextBlock Name="txtHeaderSubtitle"
                                       Text="Gaming-style comic scraper: dán link nguồn, gom chapter, kiểm tra queue, rồi tải hàng loạt."
                                       Foreground="{StaticResource CyberpunkMutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Border Style="{StaticResource BadgeCard}">
                                    <TextBlock Text="MANGA / MANHUA"
                                               Foreground="{StaticResource CyberpunkTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                                <Border Style="{StaticResource BadgeCard}">
                                    <TextBlock Text="QUEUE-FIRST WORKFLOW"
                                               Foreground="{StaticResource CyberpunkTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                                <Border Style="{StaticResource BadgeCard}">
                                    <TextBlock Text="BASE 100% = 1360x768"
                                               Foreground="{StaticResource CyberpunkYellowBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <Grid Name="headerUtilityPanel" Grid.Column="1" MinWidth="220" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Name="languageCard" Style="{StaticResource MetricCard}" Padding="8,6" BorderBrush="{StaticResource CyberpunkBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="INTERFACE LANGUAGE" TextWrapping="Wrap" Foreground="{StaticResource CyberpunkMutedTextBrush}" FontSize="9" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Name="txtLanguageLabel"
                                                   Text="ENG"
                                                   Foreground="{StaticResource CyberpunkMutedTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ToggleButton Name="tglLanguage"
                                                      Style="{StaticResource ToggleButtonSwitch}"
                                                      Width="38"
                                                      Height="18"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Checked="TglLanguage_Checked"
                                                      Unchecked="TglLanguage_Unchecked"/>
                                        <TextBlock Name="txtLanguageTarget"
                                                   Text="VI"
                                                   Foreground="{StaticResource CyberpunkCyanBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2"
                                    Name="scaleCard"
                                    Style="{StaticResource MetricCard}"
                                    Padding="8,8"
                                    BorderBrush="{StaticResource CyberpunkBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="txtScaleLabel"
                                                   Text="DISPLAY SCALE"
                                                   Foreground="{StaticResource CyberpunkMutedTextBrush}"
                                                   FontSize="9"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1"
                                                   Name="txtScaleValue"
                                                   Text="100%"
                                                   Foreground="{StaticResource CyberpunkYellowBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Name="txtScaleHint"
                                               Text="100% = baseline cho 1360x768"
                                               Foreground="{StaticResource CyberpunkMutedTextBrush}"
                                               FontSize="9"
                                               Margin="0,2,0,6"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Name="btnZoomOut"
                                                Content="-"
                                                Click="BtnZoomOut_Click"
                                                Style="{StaticResource ScaleControlButton}"/>
                                        <Button Name="btnZoomReset"
                                                Content="100%"
                                                Click="BtnZoomReset_Click"
                                                Style="{StaticResource ScaleResetButton}"/>
                                        <Button Name="btnZoomIn"
                                                Content="+"
                                                Click="BtnZoomIn_Click"
                                                Style="{StaticResource ScaleControlButton}"/>
                                    </StackPanel>
                                    <Slider Name="sldUiScale"
                                            Margin="0,6,0,0"
                                            ValueChanged="SldUiScale_ValueChanged"
                                            Value="100"
                                            Style="{StaticResource ScaleSlider}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <WrapPanel Name="headerStepsPanel" Grid.Row="1" Margin="0,0,0,0">
                        <Border Style="{StaticResource HeroStepCard}">
                            <StackPanel>
                                <TextBlock Name="txtHeaderStepPrimary"
                                           Text="STEP 1"
                                           Foreground="{StaticResource CyberpunkCyanBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                                <TextBlock Name="txtHeaderStepPrimaryTitle"
                                           Text="SOURCE"
                                           Foreground="{StaticResource CyberpunkTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HeroStepCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Name="txtHeaderStepSecondary"
                                           Text="STEP 2"
                                           Foreground="{StaticResource CyberpunkCyanBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                                <TextBlock Name="txtHeaderStepSecondaryTitle"
                                           Text="DOWNLOAD"
                                           Foreground="{StaticResource CyberpunkTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Name="headerActionsPanel" Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
                        <Button Name="btnNewList" Content="NEW LIST" Click="BtnNewList_Click" Style="{StaticResource CompactCyanButton}" MinWidth="84" Padding="12,3" FontWeight="Bold"/>
                        <Button Name="btnSaveList" Content="SAVE DEFAULT" Click="BtnSave_Click" Style="{StaticResource CompactCyanButton}" MinWidth="126" Padding="12,3" FontWeight="Bold"/>
                        <Button Name="btnLoadList" Content="OPEN DEFAULT" Click="BtnLoad_Click" Style="{StaticResource CompactCyanButton}" MinWidth="126" Padding="12,3" FontWeight="Bold"/>
                        <Button Name="btnSaveCustomList" Content="SAVE AS" Click="BtnSaveCustom_Click" Style="{StaticResource CompactPinkButton}" MinWidth="126" Padding="12,3" FontWeight="Bold"/>
                        <Button Name="btnLoadCustomList" Content="OPEN FILE" Click="BtnLoadCustom_Click" Style="{StaticResource CompactPinkButton}" MinWidth="126" Padding="12,3" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Name="leftPanelHost" Grid.Column="0" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,10" Padding="14" Style="{StaticResource CyberpunkCard}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Name="txtCreateSubfolderTitle"
                                   Grid.Row="0"
                                   Text="CREATE SUBFOLDER"
                                   Foreground="{StaticResource CyberpunkCyanBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Name="txtCreateSubfolderDomainLabel"
                                       Grid.Column="0"
                                       Text="DOMAIN"
                                       Foreground="{StaticResource CyberpunkMutedTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox Name="cmbCreateSubfolderDomain"
                                      Grid.Column="1"
                                      Style="{StaticResource CyberpunkComboBox}"
                                      Height="30"
                                      IsEditable="False"
                                      SelectionChanged="CmbCreateSubfolderDomain_SelectionChanged"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Name="txtCreateSubfolderNameLabel"
                                       Grid.Column="0"
                                       Text="SUBFOLDER NAME"
                                       Foreground="{StaticResource CyberpunkMutedTextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBox Name="txtCreateSubfolderName"
                                     Grid.Column="1"
                                     Background="#0e121a"
                                     BorderBrush="{StaticResource CyberpunkBorderBrush}"
                                     Foreground="{StaticResource CyberpunkTextBrush}"
                                     CaretBrush="{StaticResource CyberpunkCyanBrush}"
                                     Height="32"
                                     TextChanged="TxtCreateSubfolderName_TextChanged"/>
                            <Button Name="btnApplyCreateSubfolder"
                                    Grid.Column="2"
                                    Content="APPLY"
                                    Click="BtnApplyCreateSubfolder_Click"
                                    Style="{StaticResource CompactCyanButton}"
                                    MinWidth="70"
                                    Height="32"
                                    Margin="10,0,0,0"
                                    Padding="10,2"/>
                        </Grid>
                    </Grid>
                </Border>

                <TabControl Name="tabLeftPanel" Grid.Row="1" Style="{StaticResource TabControlInLine}" Background="Transparent" BorderThickness="0">
                <!-- Manga Source Parent Tab -->
                <TabItem x:Name="tabMangaSourceRootItem" Header="Manga Source" Style="{StaticResource CyberpunkTabItem}" Tag="{StaticResource CyberpunkCyanBrush}">
                    <TabControl Name="tabManga" Style="{StaticResource TabControlInLine}" Background="Transparent" BorderThickness="0" SelectionChanged="TabManga_SelectionChanged">
                        <!-- truyenqq tab -->
                        <TabItem x:Name="tabTruyenqqItem" Header="truyenqq" Style="{StaticResource CyberpunkTabItem}">
                            <TabItem.Tag>
                                <SolidColorBrush Color="#00ff66"/>
                            </TabItem.Tag>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Background="Transparent" BorderThickness="0" Padding="0">
                            <Grid Margin="0,10,0,0">
                                <Border Name="borderTruyenqqLeftPanel" Style="{StaticResource CyberpunkCard}" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Section Title -->
                                            <RowDefinition Height="Auto"/> <!-- URL Input -->
                                            <RowDefinition Height="Auto"/> <!-- Fetch Button -->
                                            <RowDefinition Height="Auto"/> <!-- Page Info -->
                                            <RowDefinition Height="0"/>    <!-- Row Range Input -->
                                            <RowDefinition Height="Auto"/> <!-- Scrape Button -->
                                            <RowDefinition Height="*"/>    <!-- Progress Logs -->
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <TextBlock Name="txtTruyenqqSectionTitle" Text="PARAMETERS CONFIG" Foreground="{StaticResource CyberpunkCyanBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Name="btnOpenHomepageTruyenqq" Tag="truyenqq" Content="HOME" Click="BtnOpenHomepage_Click" Style="{StaticResource CompactCyanButton}" MinWidth="86" Padding="8,0" FontWeight="Bold"/>
                                                <Button Tag="truyenqq" Content="RESTORE DEFAULT TAG" Click="BtnRestoreDefaultTag_Click" Style="{StaticResource CompactCyanButton}" MinWidth="156" Padding="8,0" FontWeight="Bold"/>
                                                <Button Name="btnOpenHistory" Content="HISTORY" Click="BtnOpenHistory_Click" Style="{StaticResource CompactCyanButton}" MinWidth="78" Padding="8,0" FontWeight="Bold"/>
                                                <Button Name="btnOpenBookmarks" Content="BOOKMARKS" Click="BtnOpenBookmarks_Click" Style="{StaticResource CompactCyanButton}" MinWidth="94" Padding="8,0" FontWeight="Bold"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Target URL -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                            <TextBlock Name="txtTruyenqqTargetLabel" Text="DOWNLOAD MULTIPLE WITH TAG OR ARTIST" Foreground="{StaticResource CyberpunkMutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBox Name="txtTruyenqqTagUrl" 
                                                        Text="https://truyenqqko.com/the-loai/action-26"
                                                        Background="#0e121a" 
                                                        BorderBrush="{StaticResource CyberpunkBorderBrush}" 
                                                        Foreground="{StaticResource CyberpunkTextBrush}" 
                                                        CaretBrush="{StaticResource CyberpunkCyanBrush}"
                                                        Height="32"/>
                                        </StackPanel>

                                        <!-- Fetch Info Action -->
                                        <Grid Grid.Row="2" Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Name="btnTruyenqqFetchInfo" Content="ANALYZE TARGET PAGE" Click="BtnTruyenqqFetchInfo_Click" Style="{StaticResource TabFetchPrimaryButton}"/>
                                            <Button Grid.Column="2" Name="btnTruyenqqFetchCaptcha" Content="DELETE COOKIE" Click="BtnCaptcha_Click" Style="{StaticResource TabFetchSecondaryButton}"/>
                                        </Grid>

                                        <!-- Page Info Status (TOTAL, FROM, TO pages all on the same row) -->
                                        <Grid Grid.Row="3" Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Name="txtTruyenqqTotalPagesLabel" Text="TOTAL PAGES" Foreground="{StaticResource CyberpunkMutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <TextBox Name="txtTruyenqqTotalPages" Text="1" Background="#0e121a" BorderBrush="{StaticResource CyberpunkBorderBrush}" Foreground="{StaticResource CyberpunkYellowBrush}" FontSize="13" FontWeight="Bold" Height="32" HorizontalContentAlignment="Center" TextChanged="TxtTruyenqqTotalPages_TextChanged"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="FROM PAGE" Foreground="{StaticResource CyberpunkMutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <TextBox Name="txtTruyenqqPageFrom" Text="1" Background="#0e121a" BorderBrush="{StaticResource CyberpunkBorderBrush}" Foreground="{StaticResource CyberpunkTextBrush}" CaretBrush="{StaticResource CyberpunkCyanBrush}" Height="32" HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="TO PAGE" Foreground="{StaticResource CyberpunkMutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <TextBox Name="txtTruyenqqPageTo" Text="1" Background="#0e121a" BorderBrush="{StaticResource CyberpunkBorderBrush}" Foreground="{StaticResource CyberpunkTextBrush}" CaretBrush="{StaticResource CyberpunkCyanBrush}" Height="32" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Page Range Input (Unused, height set to 0) -->
                                        <Grid Grid.Row="4" Height="0" Margin="0"/>

                                        <!-- Scrape & Direct Import Actions -->
                                        <Grid Grid.Row="5" Margin="0,8,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Name="btnTruyenqqScrape" Content="GET LINK" Click="BtnTruyenqqScrape_Click" Style="{StaticResource WideActionButton}"/>
                                            <Button Grid.Column="2" Name="btnTruyenqqCrawlMore" Content="GET MORE" Click="BtnTruyenqqCrawlMore_Click" Style="{StaticResource WideActionButton}"/>
                                            <Button Grid.Column="4" Name="btnTruyenqqPasteDirect" Content="PASTE DIRECT LINK" Click="BtnTruyenqqPasteDirect_Click" Style="{StaticResource WideActionButton}"/>
                                        </Grid>

                                        <!-- Check Error Panel -->
                                        <Grid Grid.Row="6" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="CHECK ERROR" Foreground="{StaticResource CyberpunkPinkBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CheckErrors.Count, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=TOTAL: {0}}" Foreground="{StaticResource CyberpunkCyanBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="2" Name="btnClearCheckErrorsTruyenqq" Content="CLEAR" Click="BtnClearCheckErrors_Click" Style="{StaticResource CyberpunkButtonCyan}" Height="20" Width="60" FontSize="9" Padding="0"/>
                                            </Grid>
                                            <Border Grid.Row="1" Background="#06090e" BorderBrush="{StaticResource CyberpunkBorderBrush}" BorderThickness="1" CornerRadius="3">
                                                <DataGrid Name="dgCheckErrorsTruyenqq"
                                                          ItemsSource="{Binding CheckErrors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Foreground="{StaticResource CyberpunkTextBrush}"
                                                          HeadersVisibility="Column"
                                                          RowHeaderWidth="0"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="#1f293d"
                                                          VerticalGridLinesBrush="#1f293d"
                                                          ColumnHeaderStyle="{StaticResource CyberpunkDataGridColumnHeader}"
                                                          RowStyle="{StaticResource CyberpunkDataGridRow}"
                                                          CellStyle="{StaticResource CyberpunkDataGridCell}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="TIME" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="85" ElementStyle="{StaticResource CheckErrorWrapTextStyle}"/>
                                                        <DataGridTextColumn Header="BOOK" Binding="{Binding DisplayBook}" Width="260" ElementStyle="{StaticResource CheckErrorWrapTextStyle}"/>
                                                        <DataGridTextColumn Header="ERROR" Binding="{Binding ErrorMessage}" Width="300" ElementStyle="{StaticResource CheckErrorWrapTextStyle}"/>
