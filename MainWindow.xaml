                                    </MenuItem>
                                    <MenuItem Header="Đảo ngược trạng thái tích (Invert Checked)" Click="MenuInvertChecked_Click">
                                        <MenuItem.Icon><TextBlock Text="🔀" Foreground="#0066CC" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Name="menuSplitChaptersToParallelTasks" Header="Split Chapters to Parallel Tasks">
                                        <MenuItem.Icon><TextBlock Text="⚡" Foreground="#D97700" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
                                        <MenuItem Header="50" Tag="50" Click="MenuSplitChaptersToParallelTasks_Click"/>
                                        <MenuItem Header="100" Tag="100" Click="MenuSplitChaptersToParallelTasks_Click"/>
                                        <MenuItem Header="200" Tag="200" Click="MenuSplitChaptersToParallelTasks_Click"/>
                                        <MenuItem Header="300" Tag="300" Click="MenuSplitChaptersToParallelTasks_Click"/>
                                        <MenuItem Header="400" Tag="400" Click="MenuSplitChaptersToParallelTasks_Click"/>
