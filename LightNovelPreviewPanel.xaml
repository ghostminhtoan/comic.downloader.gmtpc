<UserControl x:Class="get_link_manga.LightNovelPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="50"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="50"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,0,5" Style="{StaticResource CyberpunkCard}" Padding="14">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PANEL 1 - BOOK" Foreground="{StaticResource CyberpunkCyanBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid x:Name="dgLightNovelBooks"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1F293D"
                              VerticalGridLinesBrush="#1F293D"
                              Foreground="{StaticResource CyberpunkCyanBrush}"
                              ColumnHeaderStyle="{StaticResource CyberpunkDataGridColumnHeader}"
                              RowStyle="{StaticResource CyberpunkDataGridRow}"
                              CellStyle="{StaticResource CyberpunkDataGridCell}"
                              Margin="0"
                              SelectionChanged="DgLightNovelBooks_SelectionChanged"
                              PreviewKeyDown="DgLightNovelBooks_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="X" Binding="{Binding IsChecked}" Width="38"/>
                            <DataGridTextColumn Header="BOOK" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding DisplayStatusText}" Width="1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="PROCESS" Binding="{Binding CurrentProcess}" Width="1.2*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

            <Border Grid.Column="2" Margin="0,0,0,5" Style="{StaticResource CyberpunkCard}" Padding="14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="PANEL 2 - CHAPTER" Foreground="{StaticResource CyberpunkCyanBrush}" FontSize="14" Margin="0,0,0,10" FontWeight="Bold"/>
                    <ListBox x:Name="lbLightNovelChapters"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource CyberpunkTextBrush}"
                             HorizontalContentAlignment="Stretch"
                             SelectionMode="Extended"
                             SelectionChanged="LbLightNovelChapters_SelectionChanged"
                             PreviewKeyDown="LbLightNovelChapters_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                    <CheckBox DockPanel.Dock="Left" Margin="0,2,10,0" VerticalAlignment="Top" IsChecked="{Binding IsChecked}"/>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="{StaticResource CyberpunkCyanBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="50"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,5,0,0" Style="{StaticResource CyberpunkCard}" Padding="14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="PANEL 3 - PLAIN TEXT" Foreground="{StaticResource CyberpunkCyanBrush}" FontSize="14" Margin="0,0,0,10" FontWeight="Bold"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="txtLightNovelSelectedChapter" Grid.Row="0" IsReadOnly="True" Style="{StaticResource SurfaceTextBox}"/>
                        <TextBox x:Name="txtLightNovelPlainText"
                                 Grid.Row="2"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Background="#0E121A"
                                 BorderBrush="{StaticResource CyberpunkBorderBrush}"
                                 Foreground="{StaticResource CyberpunkTextBrush}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="10"/>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

            <Border Grid.Column="2" Margin="0,5,0,0" Style="{StaticResource CyberpunkCard}" Padding="14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="PANEL 4 - .MD" Foreground="{StaticResource CyberpunkCyanBrush}" FontSize="14" Margin="0,0,0,10" FontWeight="Bold"/>
                    <TextBox x:Name="txtLightNovelMarkdown"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Background="#0E121A"
                             BorderBrush="{StaticResource CyberpunkBorderBrush}"
                             Foreground="{StaticResource CyberpunkYellowBrush}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="10"/>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="COPY TEXT" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ToggleButton x:Name="btnStartCopyText" Click="BtnStartLightNovelCopyToggle_Click" Style="{StaticResource FloatSwitchToggle}" IsChecked="False" ToolTip="COPY LIGHT NOVEL TEXT"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
